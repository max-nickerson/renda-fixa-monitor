# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# brapi.dev — stock quotes, fundamentals, SELIC/IPCA (https://brapi.dev/dashboard)
BRAPI_TOKEN=

# ANBIMA Developers — optional; public daily files cover debentures & títulos públicos.
# Needed only for CRI/CRA prices. (https://developers.anbima.com.br)
ANBIMA_CLIENT_ID=
ANBIMA_CLIENT_SECRET=
ANBIMA_ENV=production   # or sandbox

# E-mail alerts (Gmail: use an App Password, https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional TradingView MCP adapter for eurobond prices (needs Essential+ plan; run `python -m rfmonitor tv-login`)
TRADINGVIEW_MCP=false

# Public hosting: viewing is open to anyone with the URL; changes (add ISIN, positions, prices, refresh)
# need this key once per browser. Leave empty for local use (everything open).
ADMIN_KEY=
# Monthly ML ranking needs the research history and ~1–2 GB RAM
ENABLE_ML_SELECTION=true
# On a fresh server, download the research history in the background on first boot
BOOTSTRAP_HISTORY=false

# Server / scheduler
HOST=127.0.0.1
PORT=8000
COLLECT_EVERY_MINUTES=15
QUOTES_EVERY_SECONDS=60
BACKFILL_DAYS=180
